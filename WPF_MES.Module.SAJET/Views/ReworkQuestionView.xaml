<UserControl x:Class="WPF_MES.Module.SAJET.Views.ReworkQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#007ACC" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 顶部标题 ========== -->
        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="重工问题追踪"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- ========== 筛选栏 ========== -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <StackPanel Orientation="Horizontal">

                <Button Content="查询"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="70"
                        Margin="0,0,15,0"/>

                <TextBlock Text="楼层：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding FloorOptions}"
                          SelectedItem="{Binding SelectedFloor}"
                          Width="90"
                          Height="28"
                          VerticalContentAlignment="Center"
                          Margin="0,0,15,0"/>

                <TextBlock Text="筛选日期：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding StartDate}"
                            Width="130"
                            Height="28"
                            Margin="0,0,15,0"/>

                <TextBlock Text="关键词：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         Width="180"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Padding="6,0"
                         Margin="0,0,15,0"/>

                <CheckBox Content="未完成"
                          IsChecked="{Binding ShowUnfinishedOnly}"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ========== 表格 ========== -->
        <DataGrid Grid.Row="2"
                  x:Name="dgvResult"
                  ItemsSource="{Binding ResultItems}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource DataGridStyle}"
                  BorderThickness="0"
                  IsReadOnly="True"
                  Margin="10"
                  RowHeight="40"
                  MouseDoubleClick="DgvResult_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号"       Binding="{Binding NumberIndex}" Width="80"/>
                <DataGridTextColumn Header="产线"       Binding="{Binding PdlineName}"  Width="90"/>
                <DataGridTextColumn Header="问题描述"   Binding="{Binding SerialNumber}" Width="180"/>
                <DataGridTextColumn Header="原因"       Binding="{Binding Reason}"      Width="200"/>
                <DataGridTextColumn Header="要求"       Binding="{Binding Query}"       Width="200"/>
                <DataGridTextColumn Header="提交人"     Binding="{Binding QEmp}"        Width="90"/>
                <DataGridTextColumn Header="创建时间"   Binding="{Binding CreateDate}"  Width="150"/>
                <DataGridTextColumn Header="确认人"     Binding="{Binding CEmp}"        Width="90"/>
                <DataGridTextColumn Header="已确认"     Binding="{Binding Checked}"     Width="80"/>
                <DataGridTextColumn Header="处理人"     Binding="{Binding EmpSfis}"     Width="90"/>
                <DataGridTextColumn Header="回复"       Binding="{Binding ReworkNo}"    Width="120"/>
                <DataGridTextColumn Header="完成时间"   Binding="{Binding DualTime}"    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ========== 底部回复栏 ========== -->
        <Border Grid.Row="3"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="回复"
                        Command="{Binding ReplyCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="80"
                        Margin="0,0,10,0"/>

                <TextBox x:Name="txtReply"
                         Grid.Column="1"
                         Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                         Width="250"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Padding="6,0"
                         KeyDown="Reply_KeyDown"
                         ToolTip="回车触发回复"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Foreground="#666666"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>