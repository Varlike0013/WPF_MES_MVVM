<UserControl x:Class="WPF_MES.Module.SAJET.Views.TgsGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#007ACC" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#F0F0F0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="Black"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="TGS 行为组管理"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <Grid Grid.Row="1" Margin="10" Background="#F5F7FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7"
                            Padding="10,8"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="行为组查询"
                                   FontWeight="Bold"
                                   Foreground="#007ACC"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding InputTypes}"
                                  SelectedItem="{Binding SelectedInputType}"
                                  Height="28"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <TextBox x:Name="txtInput"
                                 Grid.Column="1"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 KeyDown="InputText_KeyDown"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F0F7FF"
                                BorderBrush="#B8D8F0"
                                BorderThickness="0,0,0,1"
                                Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID："
                                           FontWeight="Bold"
                                           Foreground="#666666"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentGroupId}"
                                           FontWeight="Bold"
                                           Foreground="#005A9E"/>
                                <TextBlock Grid.Column="2" Text="名称："
                                           FontWeight="Bold"
                                           Foreground="#666666"
                                           Margin="15,0,0,0"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding CurrentGroupName}"
                                           FontWeight="Bold"
                                           Foreground="#005A9E"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  x:Name="dgvJobs"
                                  ItemsSource="{Binding JobItems}"
                                  SelectedItem="{Binding SelectedJob}"
                                  Style="{StaticResource DataGridStyle}"
                                  BorderThickness="0"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="流程ID"       Binding="{Binding JobId}"        Width="50"/>
                                <DataGridTextColumn Header="输入名称"     Binding="{Binding TypeNameE}"    Width="80"/>
                                <DataGridTextColumn Header="过程名"       Binding="{Binding ProcCallName}" Width="100"/>
                                <DataGridTextColumn Header="存储过程名称" Binding="{Binding SprocName}"    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <TabControl Grid.Column="2"
                        FontSize="13"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">

                <TabItem Header="存储过程代码">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtQuery"
                                     Grid.Column="0"
                                     Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0"
                                     KeyDown="Query_KeyDown"
                                     ToolTip="模糊查询内容"/>

                            <Button Grid.Column="1"
                                    Content="上一个"
                                    Command="{Binding PreviousMatchCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="70"
                                    Margin="8,0,0,0"/>

                            <Button Grid.Column="2"
                                    Content="下一个"
                                    Command="{Binding NextMatchCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="70"
                                    Margin="8,0,0,0"/>
                        </Grid>

                        <RichTextBox x:Name="rtbSource"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="6"/>
                    </Grid>
                </TabItem>

                <TabItem Header="测试存储过程">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F5F5F5"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="构建"
                                        Command="{Binding BuildCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="80"
                                        Margin="0,0,8,0"/>
                                <Button Content="执行"
                                        Command="{Binding ExecuteCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="80"
                                        Margin="0,0,8,0"/>
                                <TextBox x:Name="txtProc"
                                         Text="{Binding ProcName, UpdateSourceTrigger=PropertyChanged}"
                                         Width="280"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         KeyDown="Proc_KeyDown"
                                         ToolTip="输入存储过程名称，如 SAJET.XXX"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <GroupBox Header="输入参数"
                                          Margin="0,0,0,10"
                                          Padding="8"
                                          Visibility="{Binding HasInputParams,
                                              Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding InputParams}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="26"
                                                             VerticalContentAlignment="Center"
                                                             Padding="6,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <GroupBox Header="输出结果"
                                          Padding="8"
                                          Visibility="{Binding HasOutputParams,
                                              Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding OutputParams}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Value}"
                                                             IsReadOnly="True"
                                                             Background="#F5F5F5"
                                                             Height="26"
                                                             VerticalContentAlignment="Center"
                                                             Padding="6,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>