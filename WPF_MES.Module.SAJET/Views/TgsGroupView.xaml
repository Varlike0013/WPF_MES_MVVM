<UserControl x:Class="WPF_MES.Module.SAJET.Views.TgsGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 小标签：ID / 名称 说明文字 -->
            <Style x:Key="InfoCaption" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="InfoValue" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题 ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="14,10">
            <TextBlock Text="TGS 行为组管理"
                       FontSize="16" FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================
                 左侧：行为组查询 + Job 列表
                 ============================================================ -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 卡片表头 -->
                    <Border Grid.Row="0" Style="{StaticResource InfoCardHeaderStyle}">
                        <TextBlock Text="行为组查询"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <!-- 查询栏 -->
                    <Grid Grid.Row="1" Margin="10,10,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding InputTypes}"
                                  SelectedItem="{Binding SelectedInputType}"
                                  Height="28"
                                  MinWidth="100"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,8,0"/>

                        <TextBox x:Name="txtInput"
                                 Grid.Column="1"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 MinWidth="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 KeyDown="InputText_KeyDown"/>
                    </Grid>

                    <!-- 当前组信息 + Job 列表 -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 当前组信息 -->
                        <Border Grid.Row="0"
                                Background="#F0F7FF"
                                BorderBrush="#B8D8F0"
                                BorderThickness="0,0,0,1"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID：" Style="{StaticResource InfoCaption}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentGroupId}"
                                           Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Column="2" Text="名称："
                                           Style="{StaticResource InfoCaption}"
                                           Margin="15,0,0,0"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding CurrentGroupName}"
                                           Style="{StaticResource InfoValue}"/>
                            </Grid>
                        </Border>

                        <!-- Job DataGrid -->
                        <DataGrid Grid.Row="1"
                                  x:Name="dgvJobs"
                                  ItemsSource="{Binding JobItems}"
                                  SelectedItem="{Binding SelectedJob}"
                                  Style="{StaticResource DataGridStyle}"
                                  BorderThickness="0"
                                  Margin="0"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="流程ID"       Binding="{Binding JobId}"        Width="60"/>
                                <DataGridTextColumn Header="输入名称"     Binding="{Binding TypeNameE}"    Width="90"/>
                                <DataGridTextColumn Header="过程名"       Binding="{Binding ProcCallName}" Width="110"/>
                                <DataGridTextColumn Header="存储过程名称" Binding="{Binding SprocName}"    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- ============================================================
                 右侧：TabControl（存储过程代码 / 测试）
                 ============================================================ -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <TabControl Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            SelectedIndex="0"
                            ItemContainerStyle="{StaticResource FlatTabItem}">

                    <!-- ===== Tab1：存储过程代码 ===== -->
                    <TabItem Header="存储过程代码">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 查询条 -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtQuery"
                                         Grid.Column="0"
                                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         MinWidth="0"
                                         VerticalContentAlignment="Center"
                                         Padding="8,0"
                                         KeyDown="Query_KeyDown"
                                         ToolTip="模糊查询内容"/>

                                <Button Grid.Column="1"
                                        Content="上一个"
                                        Command="{Binding PreviousMatchCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="76"
                                        Margin="8,0,0,0"/>

                                <Button Grid.Column="2"
                                        Content="下一个"
                                        Command="{Binding NextMatchCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="76"
                                        Margin="8,0,0,0"/>
                            </Grid>

                            <!-- 源码显示：包裹 Border 让背景和边框更柔和 -->
                            <Border Grid.Row="1"
                                    Background="#FAFBFC"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <RichTextBox x:Name="rtbSource"
                                             IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Padding="8"
                                             Background="Transparent"
                                             BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ===== Tab2：测试存储过程 ===== -->
                    <TabItem Header="测试存储过程">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 工具条 -->
                            <Border Grid.Row="0"
                                    Background="#F7F9FB"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="构建"
                                            Command="{Binding BuildCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="80"
                                            Margin="0,0,8,0"/>
                                    <Button Content="执行"
                                            Command="{Binding ExecuteCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="80"
                                            Margin="0,0,12,0"/>
                                    <TextBox x:Name="txtProc"
                                             Text="{Binding ProcName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="300"
                                             Height="28"
                                             VerticalContentAlignment="Center"
                                             Padding="8,0"
                                             KeyDown="Proc_KeyDown"
                                             ToolTip="输入存储过程名称，如 SAJET.XXX"/>
                                </StackPanel>
                            </Border>

                            <!-- 输入 / 输出参数 -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <GroupBox Header="输入参数"
                                              Margin="0,0,0,10"
                                              Padding="10"
                                              Visibility="{Binding HasInputParams,
                                                  Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding InputParams}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="26"
                                                                 MinWidth="0"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="6,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </GroupBox>

                                    <GroupBox Header="输出结果"
                                              Padding="10"
                                              Visibility="{Binding HasOutputParams,
                                                  Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding OutputParams}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Value}"
                                                                 IsReadOnly="True"
                                                                 Background="#F5F5F5"
                                                                 Height="26"
                                                                 MinWidth="0"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="6,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>