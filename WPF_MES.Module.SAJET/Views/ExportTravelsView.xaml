<UserControl x:Class="WPF_MES.Module.SAJET.Views.ExportTravelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#007ACC" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="出行记录导出"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="10" Background="#F5F7FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：查询条件 -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="查询条件"
                                   FontWeight="Bold"
                                   Foreground="#007ACC"
                                   Margin="0,0,0,15"/>

                        <!-- 工单 -->
                        <TextBlock Text="工单" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InputWorkOrder, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 Margin="0,0,0,12"/>

                        <!-- 料号 -->
                        <TextBlock Text="料号" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InputPartNo, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 Margin="0,0,0,12"/>

                        <!-- 线别 -->
                        <TextBlock Text="线别" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding LineOptions}"
                                  SelectedItem="{Binding SelectedLine}"
                                  DisplayMemberPath="Display"
                                  Height="30"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,12"/>

                        <!-- 工序 -->
                        <TextBlock Text="工序" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ProcessOptions}"
                                  SelectedItem="{Binding SelectedProcess}"
                                  DisplayMemberPath="Display"
                                  Height="30"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,12"/>

                        <!-- 机台 -->
                        <TextBlock Text="机台" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TerminalOptions}"
                                  SelectedItem="{Binding SelectedTerminal}"
                                  DisplayMemberPath="Display"
                                  Height="30"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,12"/>

                        <!-- 起始时间 -->
                        <TextBlock Text="起始时间" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding StartTime}"
                                    Height="30"
                                    Margin="0,0,0,12"/>

                        <!-- 结束时间 -->
                        <TextBlock Text="结束时间" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EndTime}"
                                    Height="30"
                                    Margin="0,0,0,16"/>

                        <!-- 查询按钮 -->
                        <Button Content="查询"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="34"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：结果 + 导出 -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具条 -->
                    <Border Grid.Row="0"
                            Background="#E8EEF7"
                            Padding="10,6"
                            CornerRadius="4,4,0,0">
                        <Grid>
                            <TextBlock Text="查询结果"
                                       FontWeight="Bold"
                                       Foreground="#007ACC"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="#666666"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="导出"
                                        Command="{Binding ExportCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="80"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 结果表格 -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ResultItems}"
                              Style="{StaticResource DataGridStyle}"
                              BorderThickness="0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="工单"     Binding="{Binding WorkOrder}"      Width="140"/>
                            <DataGridTextColumn Header="序列号"   Binding="{Binding SerialNumber}"   Width="150"/>
                            <DataGridTextColumn Header="料号"     Binding="{Binding PartNo}"         Width="120"/>
                            <DataGridTextColumn Header="序列号"   Binding="{Binding SerialNumber}"   Width="150"/>
                            <DataGridTextColumn Header="产线"     Binding="{Binding PdlineName}"     Width="90"/>
                            <DataGridTextColumn Header="工序"     Binding="{Binding ProcessName}"    Width="110"/>
                            <DataGridTextColumn Header="当前状态" Binding="{Binding StatusText}"     Width="80"/>
                            <DataGridTextColumn Header="产出时间" Binding="{Binding OutProcessTime}" Width="150"/>
                            <DataGridTextColumn Header="终端"     Binding="{Binding TerminalName}"   Width="100"/>
                            <DataGridTextColumn Header="员工"     Binding="{Binding EmpName}"        Width="90"/>
                            <DataGridTextColumn Header="客户"     Binding="{Binding CustomerName}"   Width="110"/>
                            <DataGridTextColumn Header="客户SN"   Binding="{Binding CustomerSN}"     Width="130"/>
                            <DataGridTextColumn Header="质检编号" Binding="{Binding QcNo}"           Width="100"/>
                            <DataGridTextColumn Header="返工编号" Binding="{Binding ReworkNo}"       Width="110"/>
                            <DataGridTextColumn Header="电压值"   Binding="{Binding PanelNo}"        Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>