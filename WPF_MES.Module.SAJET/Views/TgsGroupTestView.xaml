<UserControl x:Class="WPF_MES.Module.SAJET.Views.TgsGroupTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
        <!-- 小按钮（工具栏用） -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="TGS 行为组测试"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="10" Background="#F5F7FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶部条件栏 ===== -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="线别"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              x:Name="cboLine"
                              ItemsSource="{Binding LineOptions}"
                              SelectedItem="{Binding SelectedLine}"
                              Height="28"
                              VerticalContentAlignment="Center"
                              Margin="0,0,15,0"/>

                    <TextBlock Grid.Column="2" Text="站位"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3"
                              x:Name="cboProcess"
                              ItemsSource="{Binding ProcessOptions}"
                              SelectedItem="{Binding SelectedProcess}"
                              Height="28"
                              VerticalContentAlignment="Center"
                              Margin="0,0,15,0"/>

                    <TextBlock Grid.Column="4" Text="终端"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="5"
                              x:Name="cboTerminal"
                              ItemsSource="{Binding TerminalOptions}"
                              SelectedItem="{Binding SelectedTerminal}"
                              DisplayMemberPath="TerminalName"
                              Height="28"
                              VerticalContentAlignment="Center"
                              Margin="0,0,15,0"/>

                    <TextBlock Grid.Column="6" Text="行为ID"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="7"
                             x:Name="txtGroupId"
                             Text="{Binding InputGroupId, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             KeyDown="GroupId_KeyDown"
                             ToolTip="输入行为ID，回车查询"/>
                </Grid>
            </Border>

            <!-- ===== 执行输入栏 ===== -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="输入："
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentInputType}"
                               FontWeight="Bold"
                               Foreground="#005A9E"
                               VerticalAlignment="Center"
                               MinWidth="60"
                               Margin="0,0,10,0"/>
                    <TextBox Grid.Column="2"
                             x:Name="txtTrev"
                             Text="{Binding InputTrev, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             KeyDown="Trev_KeyDown"
                             ToolTip="输入TREV，回车执行当前步骤"/>
                    <TextBlock Grid.Column="3"
                               Text="{Binding StepDisplay}"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </Grid>
            </Border>

            <!-- ===== 下方：左右分栏 ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左侧：dataMap 表格 ===== -->
                <Border Grid.Column="0"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                    Background="#E8F5E9"
                    Padding="10,8"
                    CornerRadius="4,4,0,0">
                            <Grid>
                                <TextBlock Text="DataMap"
                               FontWeight="Bold"
                               Foreground="#2E7D32"
                               HorizontalAlignment="Left"/>
                                <Button Content="清空"
                                    Command="{Binding ClearDataMapCommand}"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Width="60"
                                    HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                      ItemsSource="{Binding DataMapItems}"
                      Style="{StaticResource DataGridStyle}"
                      BorderThickness="0"
                      IsReadOnly="True"
                      RowHeight="24">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key"   Binding="{Binding Key}"   Width="130"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="#DDDDDD"/>

                <!-- ===== 右侧：日志 ===== -->
                <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                            Background="#E8EEF7"
                            Padding="10,8"
                            CornerRadius="4,4,0,0">
                            <Grid>
                                <TextBlock Text="执行日志"
                                   FontWeight="Bold"
                                   Foreground="#007ACC"
                                   HorizontalAlignment="Left"/>
                                <Button Content="清空日志"
                                    Command="{Binding ClearLogCommand}"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Width="80" Height="22"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <TextBox x:Name="txtLog"
                             Grid.Row="1"
                             Text="{Binding LogText}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="6"
                             BorderThickness="0"
                             Background="#FAFAFA"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>