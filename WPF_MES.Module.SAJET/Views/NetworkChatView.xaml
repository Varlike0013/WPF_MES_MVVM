<UserControl x:Class="WPF_MES.Module.SAJET.Views.NetworkChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 连接栏 ===== -->
        <Border Grid.Row="0" Background="White" Padding="10,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="服务端"
                             IsChecked="{Binding IsServerMode}"
                             VerticalAlignment="Center"
                             Margin="0,0,15,0"/>
                <RadioButton Content="客户端"
                             IsChecked="{Binding IsServerMode, Converter={StaticResource InverseBool}}"
                             VerticalAlignment="Center"
                             Margin="0,0,15,0"/>

                <TextBlock Text="IP:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                         Width="140" Height="26"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding IsServerMode, Converter={StaticResource InverseBool}}"/>

                <TextBlock Text="端口:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Width="70" Height="26"
                         VerticalContentAlignment="Center"/>

                <Button Content="连接/监听"
                        Command="{Binding ConnectCommand}"
                        Width="90" Height="26"
                        Margin="15,0,5,0"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}"/>

                <Button Content="断开"
                        Command="{Binding DisconnectCommand}"
                        Width="70" Height="26"
                        Margin="5,0,0,0"
                        IsEnabled="{Binding IsConnected}"/>
            </StackPanel>
        </Border>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="1" Background="#F0F0F0" Padding="10,5">
            <TextBlock Text="{Binding Status}" Foreground="#007ACC"/>
        </Border>

        <!-- ===== 聊天记录 ===== -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding ChatLogs}"
                 Background="White"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}"
                               TextWrapping="Wrap"
                               Padding="10,4"
                               Margin="4,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter Property="Foreground" Value="#007ACC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== 输入栏 ===== -->
        <Border Grid.Row="3" Background="White" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         VerticalContentAlignment="Center"
                         KeyDown="InputText_KeyDown"/>

                <Button Grid.Column="1"
                        Content="发送"
                        Command="{Binding SendCommand}"
                        Width="70" Height="28"
                        Margin="8,0,0,0"/>

                <Button Grid.Column="2"
                        Content="发送文件"
                        Command="{Binding SendFileCommand}"
                        Width="85" Height="28"
                        Margin="8,0,0,0"/>

                <Button Grid.Column="3"
                        Content="清空"
                        Command="{Binding ClearChatCommand}"
                        Width="60" Height="28"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ===== 接收文件夹 ===== -->
        <Border Grid.Row="4" Background="#F8F8F8" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="接收文件夹:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding ReceiveFolder}"
                         IsReadOnly="True"
                         Height="26"
                         VerticalContentAlignment="Center"
                         Background="#FAFAFA"/>

                <Button Grid.Column="2"
                        Content="浏览"
                        Command="{Binding BrowseReceiveFolderCommand}"
                        Width="60" Height="26"
                        Margin="8,0,0,0"/>

                <Button Grid.Column="3"
                        Content="打开"
                        Command="{Binding OpenReceiveFolderCommand}"
                        Width="60" Height="26"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>