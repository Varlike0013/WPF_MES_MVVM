<UserControl x:Class="WPF_MES.Module.SAJET.Views.WorkOrderMaintainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 标题 -->
            <RowDefinition Height="Auto"/>
            <!-- 查询栏 -->
            <RowDefinition Height="*"/>
            <!-- 主区域 -->
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题 ===== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="14,10">
            <TextBlock Text="工单维护" FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- ===== 查询栏 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="工单状态"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding WoStatusList}"
                  SelectedIndex="{Binding SelectedWoStatusIndex}"
                  Width="110" Height="28"
                  Margin="0,0,20,0"/>

                <TextBlock Text="筛选条件"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding FilterTypeList}"
                  SelectedIndex="{Binding SelectedFilterTypeIndex}"
                  Width="100" Height="28"
                  Margin="0,0,10,0"/>

                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Width="240"
                 MaxLength="120"
                 Height="28"
                 VerticalContentAlignment="Center"
                 Padding="8,0"
                 Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="查询"
                Command="{Binding SearchCommand}"
                Style="{StaticResource PrimaryButton}"
                Width="80"/>

                <TextBlock Text="{Binding ResultMessage}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== 主区域：左表单 + 右结果 ===== -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧表单 ============ -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource InfoCardHeaderStyle}">
                        <TextBlock Text="工单信息" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="16,14,16,16">
                        <TextBlock Text="工单" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding WorkOrderNo}" IsReadOnly="True"
                                 Height="28" MinWidth="0" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="料号" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding PartNo}" IsReadOnly="True"
                                 Height="28" MinWidth="0" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="状态" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding StatusList}"
                                  SelectedIndex="{Binding SelectedStatusCode}"
                                  Height="28" MinWidth="0"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="流程" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding RouteName}" IsReadOnly="True"
                                 Height="28" MinWidth="0" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="起始流程" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding StartProcessList}"
                                  SelectedItem="{Binding SelectedStartProcess}"
                                  DisplayMemberPath="Name"
                                  Height="28" MinWidth="0"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="结束流程" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding EndProcessList}"
                                  SelectedItem="{Binding SelectedEndProcess}"
                                  DisplayMemberPath="Name"
                                  Height="28" MinWidth="0"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="预定产线" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding LineList}"
                                  SelectedItem="{Binding SelectedLine}"
                                  DisplayMemberPath="Name"
                                  Height="28" MinWidth="0"
                                  Margin="0,0,0,20"/>

                        <Button Content="修改工单"
                                Command="{Binding UpdateCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="140" Height="34"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- ============ 右侧结果 ============ -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SuccessCardHeaderStyle}">
                        <TextBlock Text="工单列表" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessTextBrush}"/>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding WorkOrders}"
                              SelectedItem="{Binding SelectedWorkOrder}"
                              Style="{StaticResource DataGridStyle}"
                              BorderThickness="0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="工单"     Binding="{Binding WorkOrderNo}" Width="180"/>
                            <DataGridTextColumn Header="料号"     Binding="{Binding PartNo}"      Width="120"/>
                            <DataGridTextColumn Header="规则"     Binding="{Binding WoRule}"      Width="70"/>
                            <DataGridTextColumn Header="版本"     Binding="{Binding Version}"     Width="60"/>
                            <DataGridTextColumn Header="状态码"   Binding="{Binding StatusCode}"  Width="60"/>
                            <DataGridTextColumn Header="状态描述" Binding="{Binding StatusDesc}"  Width="90"/>
                            <DataGridTextColumn Header="目标数量" Binding="{Binding TargetQty}"   Width="80"/>
                            <DataGridTextColumn Header="投入数量" Binding="{Binding InputQty}"    Width="80"/>
                            <DataGridTextColumn Header="产出数量" Binding="{Binding OutputQty}"   Width="80"/>
                            <DataGridTextColumn Header="流程"     Binding="{Binding RouteName}"   Width="160"/>
                            <DataGridTextColumn Header="起始工序" Binding="{Binding StartProcess}" Width="90"/>
                            <DataGridTextColumn Header="结束工序" Binding="{Binding EndProcess}"  Width="90"/>
                            <DataGridTextColumn Header="产线"     Binding="{Binding PdlineName}"   Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>