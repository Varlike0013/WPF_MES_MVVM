<UserControl x:Class="WPF_MES.Module.SAJET.Views.WorkOrderMaintainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部查询栏 -->
        <Border Grid.Row="0" Background="White" Padding="10,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="工单状态" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding WoStatusList}"
                          SelectedIndex="{Binding SelectedWoStatusIndex}"
                          Width="100" Height="26"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="筛选条件" VerticalAlignment="Center" Margin="20,0,8,0"/>
                <ComboBox ItemsSource="{Binding FilterTypeList}"
                          SelectedIndex="{Binding SelectedFilterTypeIndex}"
                          Width="90" Height="26"
                          VerticalContentAlignment="Center"/>

                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Height="26"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="查询"
                        Command="{Binding SearchCommand}"
                        Width="75" Height="26"
                        Margin="8,0,0,0"/>

                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主区域：左表单 + 右结果 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧表单 -->
            <Border Grid.Column="0" Background="White" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="工单"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding WorkOrderNo}"
                             IsReadOnly="True"
                             Height="26" Margin="0,5"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="料号"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding PartNo}"
                             IsReadOnly="True"
                             Height="26" Margin="0,5"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="状态"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding StatusList}"
                              SelectedIndex="{Binding SelectedStatusCode}"
                              Height="26" Margin="0,5"
                              VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="流程"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding RouteName}"
                             IsReadOnly="True"
                             Height="26" Margin="0,5"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="起始流程"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              ItemsSource="{Binding StartProcessList}"
                              SelectedItem="{Binding SelectedStartProcess}"
                              DisplayMemberPath="Name"
                              Height="26" Margin="0,5"
                              VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="结束流程"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="5" Grid.Column="1"
                              ItemsSource="{Binding EndProcessList}"
                              SelectedItem="{Binding SelectedEndProcess}"
                              DisplayMemberPath="Name"
                              Height="26" Margin="0,5"
                              VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="预定产线"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="6" Grid.Column="1"
                              ItemsSource="{Binding LineList}"
                              SelectedItem="{Binding SelectedLine}"
                              DisplayMemberPath="Name"
                              Height="26" Margin="0,5"
                              VerticalContentAlignment="Center"/>

                    <Button Grid.Row="7" Grid.Column="1"
                            Content="修改"
                            Command="{Binding UpdateCommand}"
                            Height="32" Width="120"
                            HorizontalAlignment="Left"
                            Margin="0,8"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- 右侧结果 -->
            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding WorkOrders}"
                      SelectedItem="{Binding SelectedWorkOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#F0F0F0"
                      RowHeight="26">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="工单"     Binding="{Binding WorkOrderNo}" Width="180"/>
                    <DataGridTextColumn Header="料号"     Binding="{Binding PartNo}" Width="120"/>
                    <DataGridTextColumn Header="规则"     Binding="{Binding WoRule}" Width="80"/>
                    <DataGridTextColumn Header="版本"     Binding="{Binding Version}" Width="60"/>
                    <DataGridTextColumn Header="状态码"   Binding="{Binding StatusCode}" Width="60"/>
                    <DataGridTextColumn Header="状态描述" Binding="{Binding StatusDesc}" Width="80"/>
                    <DataGridTextColumn Header="目标数量" Binding="{Binding TargetQty}" Width="80"/>
                    <DataGridTextColumn Header="投入数量" Binding="{Binding InputQty}" Width="80"/>
                    <DataGridTextColumn Header="产出数量" Binding="{Binding OutputQty}" Width="80"/>
                    <DataGridTextColumn Header="流程"     Binding="{Binding RouteName}" Width="160"/>
                    <DataGridTextColumn Header="起始工序" Binding="{Binding StartProcess}" Width="80"/>
                    <DataGridTextColumn Header="结束工序" Binding="{Binding EndProcess}" Width="80"/>
                    <DataGridTextColumn Header="产线"     Binding="{Binding PdlineName}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>