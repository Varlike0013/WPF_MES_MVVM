<Window x:Class="WPF_MES.Module.SAJET.Views.ReworkConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重工序号确认"
        Width="560" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        FontSize="13"
        ShowInTaskbar="False">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 新工单（只读） ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="新工单"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="lblNewWorkOrder"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="Red"/>
        </Grid>

        <!-- ===== 重工单号 + 数量（只读） ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="重工单号"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="lblReworkNo"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="Red"/>
            <TextBlock Grid.Column="2" Text="数量"
                       VerticalAlignment="Center"
                       Margin="20,0,8,0"/>
            <TextBlock Grid.Column="3" x:Name="lblSnCount"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="Red"
                       FontSize="14"/>
        </Grid>

        <!-- ===== 重工流程（只读） ===== -->
        <GroupBox Grid.Row="2" Header="重工流程"
                  Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="途程名称"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblRoute"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="Red"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="制程别"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblProcess"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="Red"/>
            </Grid>
        </GroupBox>

        <!-- ===== 重工条件（只读展示，禁用交互） ===== -->
        <GroupBox Grid.Row="3" Header="重工条件"
          Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0"
                  x:Name="chkClearCustomerSN"
                  Content="清除出货序号"
                  IsHitTestVisible="False"
                  Focusable="False"/>

                <CheckBox Grid.Row="0" Grid.Column="1"
                  x:Name="chkClearPack"
                  Content="清除包装信息"
                  IsHitTestVisible="False"
                  Focusable="False"/>

                <CheckBox Grid.Row="1" Grid.Column="0"
                  x:Name="chkClearQc"
                  Content="清除抽验信息"
                  IsHitTestVisible="False"
                  Focusable="False"/>

                <CheckBox Grid.Row="1" Grid.Column="1"
                  x:Name="chkClearMac"
                  Content="清除MAC"
                  IsHitTestVisible="False"
                  Focusable="False"/>

                <CheckBox Grid.Row="2" Grid.Column="0"
                  x:Name="chkClearParts"
                  Content="清除料件"
                  IsHitTestVisible="False"
                  Focusable="False"/>
            </Grid>
        </GroupBox>

        <!-- ===== 条件说明（可编辑） ===== -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="条件说明"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="txtCondition"
                     Grid.Column="1"
                     Text="Rework"
                     Height="26"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <!-- ===== 备注说明（可编辑） ===== -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="备注说明"
                       Margin="0,0,0,4"/>
            <TextBox Grid.Row="1"
                     x:Name="txtRemark"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="6,4"/>
        </Grid>

        <!-- ===== 按钮 ===== -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button Content="确定"
                    Width="100" Height="32"
                    IsDefault="True"
                    Click="BtnOk_Click"
                    Cursor="Hand"/>
            <Button Content="取消"
                    Width="100" Height="32"
                    Margin="15,0,0,0"
                    IsCancel="True"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>