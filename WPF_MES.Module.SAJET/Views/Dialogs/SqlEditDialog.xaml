<Window x:Class="WPF_MES.Module.SAJET.Views.Dialogs.SqlEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加 SQL 语句"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        FontSize="13"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="名称" Margin="0,0,0,4"/>
        <TextBox x:Name="txtName" Grid.Row="0"
                 Height="30" VerticalContentAlignment="Center"
                 Padding="6,0" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="1" Text="类型" Margin="0,0,0,4"/>
        <ComboBox x:Name="cboType" Grid.Row="1"
                  ItemsSource="{Binding QueryTypes}"
                  Height="30" VerticalContentAlignment="Center"
                  Margin="0,20,0,10"/>

        <TextBlock Grid.Row="2" Text="描述" Margin="0,0,0,4"/>
        <TextBox x:Name="txtDesc" Grid.Row="2"
                 Height="30" VerticalContentAlignment="Center"
                 Padding="6,0" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="3" Text="SQL 语句" Margin="0,0,0,4"/>
        <TextBox x:Name="txtSql" Grid.Row="3"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 Padding="6"
                 Margin="0,20,0,15"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="确定" Width="90" Height="32"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消" Width="90" Height="32"
                    Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>