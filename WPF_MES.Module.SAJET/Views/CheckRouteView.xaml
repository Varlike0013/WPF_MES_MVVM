<UserControl x:Class="WPF_MES.Module.SAJET.Views.CheckRouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <!-- 主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#007ACC" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#F0F0F0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="Black"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格样式 -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部标题栏 ============ -->
        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="流程查询"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- ============ 主体：三列布局 ============ -->
        <Grid Grid.Row="1" Margin="10" Background="#F5F7FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：流程列表 ===== -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7"
                            Padding="10,8"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="流程列表"
                                   FontWeight="Bold"
                                   Foreground="#007ACC"/>
                    </Border>

                    <!-- 搜索 -->
                    <Grid Grid.Row="1" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtFilter"
                                 Grid.Column="0"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <Button Grid.Column="1"
                                Content="刷新"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="60"/>
                    </Grid>

                    <!-- 流程列表 -->
                    <ListBox Grid.Row="2"
                             x:Name="lstRoutes"
                             ItemsSource="{Binding FilteredRoutes}"
                             SelectedItem="{Binding SelectedRoute}"
                             BorderThickness="0"
                             FontSize="13">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- ===== 中：工序条件 ===== -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7"
                            Padding="10,8"
                            CornerRadius="4,4,0,0">
                        <Grid>
                            <TextBlock Text="工序筛选条件"
                                       FontWeight="Bold"
                                       Foreground="#007ACC"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="☑ 必过   ◪ 必不过   ☐ 忽略"
                                       FontSize="11"
                                       Foreground="#666666"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProcessItems}"
                              Style="{StaticResource DataGridStyle}"
                              BorderThickness="0"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="站位段"
                                                Binding="{Binding StageName}"
                                                Width="120"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="站位名称"
                                                Binding="{Binding ProcessName}"
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="站位ID"
                                                Binding="{Binding ProcessId}"
                                                Width="90"
                                                IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="选择" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsThreeState="True"
                                                  IsChecked="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD"
                            BorderThickness="0,1,0,0"
                            Padding="10,8">
                        <Button Content="查询符合条件的流程"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="200"
                                Height="34"
                                HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- ===== 右：流程展示 ===== -->
            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7"
                            Padding="10,8"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="流程步骤"
                                   FontWeight="Bold"
                                   Foreground="#007ACC"/>
                    </Border>

                    <!-- 流程名 -->
                    <Border Grid.Row="1"
                        Background="#F0F7FF"
                        BorderBrush="#B8D8F0"
                        BorderThickness="0,0,0,1"
                        Padding="10,4">
                        <TextBox Text="{Binding SelectedRoute, TargetNullValue='(未选择)'}"
                             FontWeight="Bold"
                             FontSize="14"
                             Foreground="#005A9E"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Cursor="IBeam"
                             TextAlignment="Center"
                             Padding="0"/>
                    </Border>

                    <!-- 步骤列表 -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding RouteSteps}"
                             BorderThickness="0"
                             FontSize="13"
                             Padding="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Necessary}" Value="Y">
                                        <Setter Property="Foreground" Value="#0050C8"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Necessary}" Value="N">
                                        <Setter Property="Foreground" Value="#D9534F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ProcessName}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NecessaryDisplay}"
                                               FontSize="11"
                                               Margin="8,0,0,0"
                                               Foreground="#888888"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 复制按钮 -->
                    <Border Grid.Row="3"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD"
                            BorderThickness="0,1,0,0"
                            Padding="10,8">
                        <Button Content="复制到新流程"
                                Command="{Binding CopyRouteCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="32"
                                HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>