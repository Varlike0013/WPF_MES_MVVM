<UserControl x:Class="WPF_MES.Module.SAJET.Views.SmtReelInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表单里 Label 统一样式 -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="SMT 料盘信息"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="10" Background="#F5F7FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：编辑区 ===== -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="索引：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditIndex, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Width="150"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="线别：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditLine, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Width="150"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="站位：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditSite, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Width="150"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="料盘：" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditSn, Mode=OneWay}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Width="150"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="状态：" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Width="150" Height="26"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding ActiveOptions}"
                                  SelectedItem="{Binding EditActive, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <Button Content="保存" Width="80" Margin="4"
                                Style="{StaticResource SmallButtonStyle}"
                                Command="{Binding SaveCommand}"/>
                        <Button Content="删除" Width="80" Margin="4"
                                Style="{StaticResource SmallButtonStyle}"
                                Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- ===== 右侧：查询 + 表格 ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 查询栏 -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="重载缓存"
                                Style="{StaticResource SmallButtonStyle}"
                                Margin="0,0,12,0"
                                Command="{Binding ReloadCommand}"/>

                        <TextBlock Text="线别：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="140" Height="26"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,12,0"
                                  ItemsSource="{Binding LineOptions}"
                                  SelectedItem="{Binding SelectedLine}"/>

                        <TextBlock Text="站位：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="140" Height="26"
                                  VerticalContentAlignment="Center"
                                  IsEditable="True"
                                  ItemsSource="{Binding SiteOptions}"
                                  Text="{Binding SelectedSite, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="..."
                                Style="{StaticResource SmallButtonStyle}"
                                Width="30" Margin="4,0,12,0"
                                Command="{Binding LoadSitesCommand}"/>

                        <TextBlock Text="上料时间：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker Width="130" Height="26" Margin="0,0,4,0"
                                    SelectedDate="{Binding InputDate}"/>
                        <TextBox Width="70" Height="26"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 Margin="0,0,12,0"
                                 Text="{Binding InputTimeText, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="查询"
                                Style="{StaticResource SmallButtonStyle}"
                                Width="80"
                                Command="{Binding SelectCommand}"/>
                    </WrapPanel>
                </Border>

                <!-- 表格 -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DataGrid ItemsSource="{Binding ReelList}"
                              SelectedItem="{Binding SelectedReel}"
                              Style="{StaticResource DataGridStyle}"
                              BorderThickness="0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="索引"
                                                Binding="{Binding NumIndex}"
                                                Visibility="Collapsed"/>
                            <DataGridTextColumn Header="站点"     Binding="{Binding Site}"       Width="80"/>
                            <DataGridTextColumn Header="线别"     Binding="{Binding LineId}"     Width="80"/>
                            <DataGridTextColumn Header="料盘"     Binding="{Binding ReelUpSn}"   Width="150"/>
                            <DataGridTextColumn Header="操作员"   Binding="{Binding EmpName}"    Width="100"/>
                            <DataGridTextColumn Header="剩余数量" Binding="{Binding RemainQty}"  Width="80"/>
                            <DataGridTextColumn Header="上料时间"
                                                Binding="{Binding LoadReelDate, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="150"/>
                            <DataGridTextColumn Header="用完时间"
                                                Binding="{Binding OverDate, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="150"/>
                            <DataGridTextColumn Header="旧料盘"   Binding="{Binding OldReelUpSn}" Width="150"/>
                            <DataGridTextColumn Header="数量"     Binding="{Binding Qty}"        Width="60"/>
                            <DataGridTextColumn Header="状态"     Binding="{Binding Active}"     Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
        
        <Border Background="#88000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyMessage}"
                       Foreground="White" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" Width="220" Height="6"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>