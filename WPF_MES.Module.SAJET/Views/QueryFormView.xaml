<UserControl x:Class="WPF_MES.Module.SAJET.Views.QueryFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#007ACC" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#F0F0F0"
                                BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="Black"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#D9534F" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C9302C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="SQL 查询管理"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Grid Grid.Row="1" Margin="10" Background="#F5F7FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左列 ===== -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7" Padding="10,8"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="查询列表" FontWeight="Bold" Foreground="#007ACC"/>
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" Margin="8"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             ToolTip="输入名称模糊查询"/>

                    <DataGrid Grid.Row="2"
                          ItemsSource="{Binding FilteredQueries}"
                          SelectedItem="{Binding SelectedQuery}"
                          Style="{StaticResource DataGridStyle}"
                          BorderThickness="0"
                          AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="8">
                        <Button Content="添加" Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButton}" Width="70"/>
                        <Button Content="修改" Command="{Binding UpdateCommand}"
                                Style="{StaticResource SecondaryButton}" Width="70" Margin="8,0,0,0"/>
                        <Button Content="删除" Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}" Width="70" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- ===== 中列 ===== -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7" Padding="10,8"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="编辑" FontWeight="Bold" Foreground="#007ACC"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="8,8,8,0">
                        <TextBlock Text="描述" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Padding="6"
                                 Margin="0,0,0,8"/>

                        <TextBlock Text="SQL 语句" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditSql, UpdateSourceTrigger=PropertyChanged}"
                                 Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Padding="6" Margin="0,0,0,8"/>
                    </StackPanel>

                    <!-- 参数区 -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="8,0">
                        <GroupBox Header="输入参数"
                                  Padding="8"
                                  Visibility="{Binding HasParams,
                                      Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding ParamItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="26"
                                                     VerticalContentAlignment="Center"
                                                     Padding="6,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="8">
                        <Button Content="构建" Command="{Binding BuildCommand}"
                                Style="{StaticResource SecondaryButton}" Width="80"/>
                        <Button Content="执行" Command="{Binding ExecuteCommand}"
                                Style="{StaticResource PrimaryButton}" Width="80" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- ===== 右列 ===== -->
            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7" Padding="10,6"
                            CornerRadius="4,4,0,0">
                        <Grid>
                            <TextBlock Text="查询结果" FontWeight="Bold"
                                       Foreground="#007ACC"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <Button Content="导出" Command="{Binding ExportCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="80" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ResultData}"
                              Style="{StaticResource DataGridStyle}"
                              BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>