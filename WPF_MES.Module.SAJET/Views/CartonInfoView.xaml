<UserControl x:Class="WPF_MES.Module.SAJET.Views.CartonInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <!-- 主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#007ACC" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#F0F0F0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="Black"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 橙色按钮（全部打开/出库） -->
        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#E8A000" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C88A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格样式 -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F8F8"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部标题栏 ============ -->
        <Border Grid.Row="0" Background="#007ACC" Padding="12,10">
            <TextBlock Text="箱号管理"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Margin="10" Background="#F5F7FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧操作区 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 顶部：查询条件 -->
                    <RowDefinition Height="*"/>
                    <!-- 中间：条件列表（自适应） -->
                    <RowDefinition Height="Auto"/>
                    <!-- 底部：编辑 + WQC -->
                </Grid.RowDefinitions>

                <!-- ========== 顶部：查询条件 ========== -->
                <Border Grid.Row="0"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10"
            Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="查询条件"
                       FontWeight="Bold"
                       Foreground="#007ACC"
                       Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                          ItemsSource="{Binding InputTypes}"
                          SelectedItem="{Binding SelectedInputType}"
                          DisplayMemberPath="Display"
                          Height="28"
                          VerticalContentAlignment="Center"
                          Margin="0,0,6,0"/>
                            <TextBox x:Name="txtInput"
                         Grid.Column="1"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         VerticalContentAlignment="Center"
                         KeyDown="InputText_KeyDown"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="查询"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="70"/>
                            <Button Content="清空"
                        Command="{Binding ClearConditionsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="70"
                        Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="全部打开"
                        Command="{Binding OpenAllCommand}"
                        Style="{StaticResource WarnButton}"
                        Width="90"/>
                            <Button Content="全部出库"
                        Command="{Binding OutAllCommand}"
                        Style="{StaticResource WarnButton}"
                        Width="90"
                        Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 中间：条件列表（撑满剩余空间） ========== -->
                <Border Grid.Row="1"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                    Background="#E8EEF7"
                    Padding="10,8"
                    CornerRadius="4,4,0,0">
                            <TextBlock Text="条件列表"
                           FontWeight="Bold"
                           Foreground="#007ACC"/>
                        </Border>

                        <DataGrid Grid.Row="1"
                      ItemsSource="{Binding ConditionItems}"
                      Style="{StaticResource DataGridStyle}"
                      BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="条件" Binding="{Binding TypeName}" Width="80"/>
                                <DataGridTextColumn Header="值"   Binding="{Binding Value}"    Width="*"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                        FontSize="14"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="RemoveCondition_Click"
                                        Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========== 底部：单条编辑 + WQC ========== -->
                <StackPanel Grid.Row="2">

                    <!-- 单条编辑 -->
                    <Border Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="选中记录编辑"
                           FontWeight="Bold"
                           Foreground="#007ACC"
                           Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="箱号"
                               VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding EditCartonNo}"
                             IsReadOnly="True"
                             Height="26"
                             Background="#F5F5F5"
                             VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="工单"
                               VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding EditWorkOrder, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="包装工单"
                               VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding EditPackWorkOrder, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="数量"
                               VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding EditQty, UpdateSourceTrigger=PropertyChanged}"
                             Height="26"
                             VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="状态"
                               VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="4" Grid.Column="1"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus}"
                              DisplayMemberPath="Display"
                              Height="26"
                              VerticalContentAlignment="Center"/>
                            </Grid>

                            <Button Content="修改"
                        Command="{Binding UpdateCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <!-- 箱号退出QC -->
                    <Border Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
                        <StackPanel>
                            <TextBlock Text="箱号退出 QC"
                           FontWeight="Bold"
                           Foreground="#007ACC"
                           Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtWqc"
                             Grid.Column="0"
                             Text="{Binding WqcCartonNo, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             VerticalContentAlignment="Center"
                             KeyDown="Wqc_KeyDown"
                             Margin="0,0,6,0"/>

                                <Button Grid.Column="1"
                            Content="确定"
                            Command="{Binding WqcCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Width="70"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== 右侧结果表格 ===== -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#E8EEF7"
                            Padding="10,8"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="查询结果"
                                   FontWeight="Bold"
                                   Foreground="#007ACC"/>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="dgvResult"
                              ItemsSource="{Binding ResultItems}"
                              SelectedItem="{Binding SelectedResultItem}"
                              Style="{StaticResource DataGridStyle}"
                              BorderThickness="0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="工单"       Binding="{Binding WorkOrder}"      Width="140"/>
                            <DataGridTextColumn Header="更新人员"   Binding="{Binding UpdateEmp}"     Width="90"/>
                            <DataGridTextColumn Header="更新时间"   Binding="{Binding UpdateTime}"    Width="140"/>
                            <DataGridTextColumn Header="数量"       Binding="{Binding Qty}"           Width="60"/>
                            <DataGridTextColumn Header="包装工单"   Binding="{Binding PackWorkOrder}" Width="140"/>
                            <DataGridTextColumn Header="料号"       Binding="{Binding PartNo}"        Width="110"/>
                            <DataGridTextColumn Header="箱号"       Binding="{Binding CartonNo}"      Width="120"/>
                            <DataGridTextColumn Header="状态"       Binding="{Binding StatusDesc}"    Width="70"/>
                            <DataGridTextColumn Header="终端"       Binding="{Binding TerminalName}"  Width="100"/>
                            <DataGridTextColumn Header="创建人员"   Binding="{Binding CreateEmp}"     Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>