<UserControl x:Class="WPF_MES.Module.SAJET.Views.PcbQrCodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei"
             FontSize="13">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="12,10">
            <TextBlock Text="PCB 二维码管理"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="10" Background="{StaticResource PageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 查询条件 -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="查询条件"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding InputTypes}"
                                      SelectedItem="{Binding SelectedInputType}"
                                      DisplayMemberPath="Display"
                                      Height="28"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,6,0"/>
                            <TextBox x:Name="txtInput"
                                     Grid.Column="1"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     KeyDown="InputText_KeyDown"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="查询"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="70"/>
                            <Button Content="清空"
                                    Command="{Binding ClearConditionsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="70"
                                    Margin="8,0,0,0"/>
                            <Button Content="全部删除"
                                    Command="{Binding DeleteAllCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Width="90"
                                    Margin="8,0,0,0"/>
                            <Button Content="新增"
                                    Command="{Binding AddCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="70"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 条件列表 -->
                <Border Grid.Row="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource InfoCardHeaderStyle}">
                            <TextBlock Text="条件列表"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ConditionItems}"
                                  Style="{StaticResource DataGridStyle}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="条件" Binding="{Binding TypeName}" Width="80"/>
                                <DataGridTextColumn Header="值"   Binding="{Binding Value}"    Width="*"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    FontSize="14"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="RemoveCondition_Click"
                                                    Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 编辑区 -->
                <Border Grid.Row="2"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="选中记录编辑"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ECS料件号"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding EditEcsPartNo, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="PCB客户料号"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding EditPcbCustPn, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PCB序号"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding EditPcbSn, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="序列号"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding EditStrSmtsn, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="PCB二维码"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding EditPcbQrcode, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <Button Content="修改"
                                Command="{Binding UpdateCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 右侧表格 ===== -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource InfoCardHeaderStyle}">
                        <TextBlock Text="查询结果（点击行可回填）"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ResultItems}"
                              SelectedItem="{Binding SelectedItem}"
                              Style="{StaticResource DataGridStyle}"
                              BorderThickness="0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ECS零件号"  Binding="{Binding EcsPartNo}"  Width="130"/>
                            <DataGridTextColumn Header="PCB客户PN"  Binding="{Binding PcbCustPn}"  Width="130"/>
                            <DataGridTextColumn Header="PCB SN"     Binding="{Binding PcbSn}"      Width="130"/>
                            <DataGridTextColumn Header="STR SMTSN"  Binding="{Binding StrSmtsn}"   Width="150"/>
                            <DataGridTextColumn Header="PCB二维码"  Binding="{Binding PcbQrcode}"  Width="*"/>
                            <DataGridTextColumn Header="创建时间"   Binding="{Binding CreateTime}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>