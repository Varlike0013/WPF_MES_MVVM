<Window x:Class="WPF_MES_MVVM.Views.NetworkLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="访问网络共享"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="16" Padding="20"
                Effect="{StaticResource SoftShadow}">
            <StackPanel>
                <TextBlock Text="访问网络共享" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="共享路径" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="txtPath" Height="30" IsReadOnly="True"
                         Background="#F5F5F5"
                         Padding="8,0" VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                <TextBlock Text="用户名" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="txtUser" Height="30"
                         Padding="8,0" VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                <TextBlock Text="密码" Style="{StaticResource Lbl}"/>
                <PasswordBox x:Name="txtPwd" Height="30"
                             Padding="8,0" VerticalContentAlignment="Center"
                             Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="80" Height="30"
                            Style="{StaticResource SecondaryButton}"
                            IsCancel="True" Margin="0,0,10,0"/>
                    <Button Content="连接" Width="80" Height="30"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Click="BtnConnect_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>