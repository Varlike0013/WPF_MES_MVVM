<Window x:Class="WPF_MES_MVVM.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES 系统登录"
        Width="450" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        FontSize="13">

    <StackPanel Margin="30">
        <TextBlock Text="MES 系统登录"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <TextBlock Text="选择系统" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding Modules}"
              SelectedItem="{Binding SelectedModule}"
              Height="30"
              VerticalContentAlignment="Center">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="用户名" Margin="0,15,0,5"/>
        <ComboBox x:Name="cboUserNo"
                  ItemsSource="{Binding UserNoHistory}"
                  Text="{Binding UserNo, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"
                  Height="30"
                  VerticalContentAlignment="Center"
                  KeyDown="CboUserNo_KeyDown"/>

        <TextBlock Text="密码" Margin="0,15,0,5"/>
        <PasswordBox x:Name="pwdBox"
                     Height="30"
                     VerticalContentAlignment="Center"
                     KeyDown="PwdBox_KeyDown"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,25,0,0">
            <Button Content="登录"
                    Width="90" Height="32"
                    IsDefault="True"
                    Click="BtnLogin_Click"/>
            <Button Content="取消"
                    Width="90" Height="32"
                    Margin="10,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>