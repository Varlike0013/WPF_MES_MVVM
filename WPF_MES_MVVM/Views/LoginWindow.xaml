<Window x:Class="WPF_MES_MVVM.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES 系统登录"
        Width="500" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 表单标签：左对齐，次要色，小字号 -->
            <Style x:Key="LoginCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="2,0,0,6"/>
            </Style>

            <!-- 密码框：圆角 + focus/hover 主蓝边框 -->
            <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SecondaryBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource DisabledBgBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource DisabledFgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid HorizontalAlignment="Left" Width="500">
        <!-- 背景：浅灰 → 淡蓝渐变 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F5F7FA" Offset="0"/>
                <GradientStop Color="#DDE7F2" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 顶部主色装饰条 -->
        <Border Height="4"
                VerticalAlignment="Top"
                Background="{StaticResource PrimaryBrush}"/>

        <!-- 登录卡片 -->
        <Border Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32,32,32,28"
                Effect="{StaticResource SoftShadow}">
            <StackPanel>
                <!-- Logo / 标题 -->
                <TextBlock Text="MES"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="制造执行系统"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,28"/>

                <!-- 选择系统 -->
                <TextBlock Text="选择系统" Style="{StaticResource LoginCaption}"/>
                <ComboBox ItemsSource="{Binding Modules}"
                          SelectedItem="{Binding SelectedModule}"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,18">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 用户名 -->
                <TextBlock Text="用户名" Style="{StaticResource LoginCaption}"/>
                <ComboBox x:Name="cboUserNo"
                          ItemsSource="{Binding UserNoHistory}"
                          Text="{Binding UserNo, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,18"
                          KeyDown="CboUserNo_KeyDown"/>

                <!-- 密码 -->
                <TextBlock Text="密码" Style="{StaticResource LoginCaption}"/>
                <PasswordBox x:Name="pwdBox"
                             Style="{StaticResource LoginPasswordBox}"
                             KeyDown="PwdBox_KeyDown"/>

                <!-- 按钮区 -->
                <Grid Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            IsCancel="True"/>

                    <Button Grid.Column="2"
                            Content="登录"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            IsDefault="True"
                            Click="BtnLogin_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>