<Window x:Class="WPF_MES_MVVM.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WPF_MES_MVVM.ViewModels"
        Title="{Binding Title}"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Microsoft YaHei"
        FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================ -->
            <!-- 页签样式 -->
            <!-- ============================================================ -->
            <Style x:Key="TabBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#DCE1E7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="5,5,0,0"/>
                <Setter Property="Margin" Value="2,0,2,0"/>
                <Setter Property="Height" Value="30"/>
            </Style>

            <!-- ============================================================ -->
            <!-- 菜单节点递归模板 -->
            <!-- ============================================================ -->
            <HierarchicalDataTemplate DataType="{x:Type vm:MenuNodeViewModel}"
                                      ItemsSource="{Binding Children}">
                <StackPanel>
                    <!-- 分组节点 -->
                    <Button Command="{Binding ToggleCommand}"
                            Style="{StaticResource MenuGroupStyle}"
                            Visibility="{Binding IsGroupVisible,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}"
                                       Width="18"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 叶子节点 -->
                    <Button Command="{Binding OpenCommand}"
                            Style="{StaticResource MenuItemStyle}"
                            Visibility="{Binding IsLeafVisible,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       Width="18"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="88"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- 顶栏 -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0069B4" Offset="0"/>
                    <GradientStop Color="#007ACC" Offset="0.55"/>
                    <GradientStop Color="#0089D9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                      BlurRadius="8" ShadowDepth="2" Opacity="0.22"/>
            </Border.Effect>

            <Grid Margin="20,0">
                <!-- 左侧：Logo + 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="#FFFFFF" Margin="0,0,12,0">
                        <TextBlock Text="M"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="#007ACC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：用户信息 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15"
                            Background="#4DA6DC" Margin="0,0,10,0">
                        <TextBlock Text="👤"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding UserDisplay}"
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 左侧菜单 -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource DarkPanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <Border Grid.Row="0"
                        Background="{StaticResource DarkPanelDeepBrush}"
                        Padding="10,8,10,6">
                    <Border Background="#2A313B"
                            CornerRadius="4"
                            Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍"
                                       FontSize="12"
                                       Foreground="#8899AA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MenuSearchBoxStyle}"
                                     ToolTip="输入关键字过滤菜单"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- 工具条 -->
                <Border Grid.Row="1"
                       Background="{StaticResource DarkPanelDeepBrush}"
                        Padding="10,0,10,8">
                    <UniformGrid Rows="1" Columns="4" Height="26">
                        <Button Content="⌂"
                                Command="{Binding GoHomeCommand}"
                                Style="{StaticResource MenuIconButtonStyle}"
                                ToolTip="回到首页"/>

                        <Button Command="{Binding ToggleFavoriteCommand}"
                                ToolTip="收藏/取消收藏当前页面">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource MenuIconButtonStyle}">
                                    <Setter Property="Content" Value="☆"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentFavorite}" Value="True">
                                            <Setter Property="Content" Value="★"/>
                                            <Setter Property="Foreground" Value="#FFD54A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="▼"
                                Command="{Binding ExpandAllCommand}"
                                Style="{StaticResource MenuIconButtonStyle}"
                                ToolTip="展开全部"/>

                        <Button Content="▶"
                                Command="{Binding CollapseAllCommand}"
                                Style="{StaticResource MenuIconButtonStyle}"
                                ToolTip="折叠全部"/>
                    </UniformGrid>
                </Border>

                <!-- 菜单树 -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                            BasedOn="{StaticResource DarkScrollBar}"/>
                    </ScrollViewer.Resources>
                    <TreeView ItemsSource="{Binding MenuNodes}"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource MenuTreeItemStyle}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 内容区 -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Grid.Column="1"
              Background="{StaticResource PageBackgroundBrush}">
            <TextBlock Text="{Binding WelcomeText}"
                       FontSize="34" FontWeight="Bold"
                       Foreground="#B8C2CC"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsWelcomeVisible,
                           Converter={StaticResource BoolToVisibility}}"/>
            <ContentControl Content="{Binding CurrentPage}"
                            Visibility="{Binding IsWelcomeVisible,
                                Converter={StaticResource BoolToVisibility},
                                ConverterParameter=Invert}"/>
        </Grid>

        <!-- ============================================================ -->
        <!-- 底栏 -->
        <!-- ============================================================ -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2"
              Background="{StaticResource CardBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 页签栏 -->
            <Border Grid.Row="0"
                    Background="#EDF1F5"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,8,8,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border"
                                               BasedOn="{StaticResource TabBorderStyle}">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#000000"
                                                      BlurRadius="4"
                                                      ShadowDepth="1"
                                                      Opacity="0.12"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel Orientation="Horizontal">
                                        <!-- 页签标题按钮 -->
                                        <Button Content="{Binding Title}"
                                                Command="{Binding SelectCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="12,0,6,0"
                                                Cursor="Hand"
                                                Focusable="False">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="#44505C"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter VerticalAlignment="Center"
                                                                                      HorizontalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 关闭按钮 -->
                                        <Button Content="×"
                                                Command="{Binding CloseCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Width="22"
                                                Cursor="Hand"
                                                Focusable="False">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="#8899AA"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        Background="Transparent"
                                                                        CornerRadius="3">
                                                                    <ContentPresenter VerticalAlignment="Center"
                                                                                      HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background"
                                                                                Value="#E74C3C"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#CFE4F5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 时间 + 按钮 -->
            <Grid Grid.Row="1">
                <TextBlock Text="{Binding TimeDisplay}"
                           Margin="16,0,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button Content="注销"
                            Width="84"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="退出"
                            Width="84"
                            Click="BtnExit_Click"
                            Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>