<Window x:Class="WPF_MES_MVVM.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WPF_MES_MVVM.ViewModels"
        Title="{Binding Title}"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Microsoft YaHei"
        FontSize="13">

    <Window.Resources>
        <!-- ============ 菜单分组节点按钮 ============ -->
        <Style x:Key="MenuGroupStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 菜单叶子节点按钮 ============ -->
        <Style x:Key="MenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 左侧工具条小按钮 ============ -->
        <Style x:Key="MenuToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 搜索框样式 ============ -->
        <Style x:Key="MenuSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ============ 菜单树 TreeViewItem 样式 ============ -->
        <Style x:Key="MenuTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Stretch"/>
                            <ItemsPresenter x:Name="ItemsHost" Margin="15,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 图标小按钮（自适应宽度） -->
        <Style x:Key="MenuIconButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ============ 页签样式 ============ -->
        <Style x:Key="TabBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D2D2D2"/>
            <Setter Property="BorderBrush" Value="#B4B4B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- ============ 菜单节点递归模板 ============ -->
        <HierarchicalDataTemplate DataType="{x:Type vm:MenuNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel>

                <!-- 分组节点：图标 + 标题 -->
                <Button Command="{Binding ToggleCommand}"
                        Style="{StaticResource MenuGroupStyle}"
                        Visibility="{Binding IsGroupVisible,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}"
                                   Width="16"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 叶子节点：图标占位 + 标题 -->
                <Button Command="{Binding OpenCommand}"
                        Style="{StaticResource MenuItemStyle}"
                        Visibility="{Binding IsLeafVisible,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <!-- 空 TextBlock 占位，让叶子文字与分组文字对齐 -->
                        <TextBlock Text=""
                                   Width="16"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#007ACC">
            <Grid Margin="20,0">
                <TextBlock Text="{Binding Title}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding UserDisplay, StringFormat=当前用户：{0}}"
                           FontSize="14"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ============ 左侧菜单 ============ -->
        <Border Grid.Row="1" Grid.Column="0" Background="#2D2D30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <Border Grid.Row="0" Background="#252526" Padding="5,5,5,3">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MenuSearchBoxStyle}"
                             ToolTip="输入关键字过滤菜单"/>
                </Border>

                <!-- 展开/折叠 工具条 -->
                <!-- 工具条：4 个图标按钮铺满整行 -->
                <Border Grid.Row="1" Background="#252526" Padding="5,0,5,5">
                    <UniformGrid Rows="1" Columns="4" Height="26">

                        <!-- 首页 -->
                        <Button Content="⌂"
                            Command="{Binding GoHomeCommand}"
                            Style="{StaticResource MenuIconButtonStyle}"
                            ToolTip="回到首页"/>

                        <!-- 收藏（☆ / ★ 切换） -->
                        <Button Command="{Binding ToggleFavoriteCommand}"
                            ToolTip="收藏/取消收藏当前页面">
                            <Button.Style>
                                <Style TargetType="Button"
                                    BasedOn="{StaticResource MenuIconButtonStyle}">
                                    <Setter Property="Content" Value="☆"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentFavorite}" Value="True">
                                            <Setter Property="Content" Value="★"/>
                                            <Setter Property="Foreground" Value="#FFD700"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 展开全部 -->
                        <Button Content="▼"
                            Command="{Binding ExpandAllCommand}"
                            Style="{StaticResource MenuIconButtonStyle}"
                            ToolTip="展开全部"/>

                        <!-- 折叠全部 -->
                        <Button Content="▶"
                            Command="{Binding CollapseAllCommand}"
                            Style="{StaticResource MenuIconButtonStyle}"
                            ToolTip="折叠全部"/>
                    </UniformGrid>
                </Border>

                <!-- 菜单树 -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TreeView ItemsSource="{Binding MenuNodes}"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource MenuTreeItemStyle}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="1" Grid.Column="1" Background="WhiteSmoke">
            <TextBlock Text="{Binding WelcomeText}"
                       FontSize="32" FontWeight="Bold"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsWelcomeVisible,
                           Converter={StaticResource BoolToVisibility}}"/>
            <ContentControl Content="{Binding CurrentPage}"
                            Visibility="{Binding IsWelcomeVisible,
                                Converter={StaticResource BoolToVisibility},
                                ConverterParameter=Invert}"/>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 页签栏 -->
            <Border Grid.Row="0" Background="#E6E6E6" Padding="5,5,5,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border"
                                               BasedOn="{StaticResource TabBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#007ACC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Title}"
                                                Command="{Binding SelectCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,0,4,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="×"
                                                Command="{Binding CloseCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Width="20"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 时间 + 按钮 -->
            <Grid Grid.Row="1">
                <TextBlock Text="{Binding TimeDisplay}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Content="注销"
                            Width="80" Height="26"
                            Margin="0,0,8,0"
                            Command="{Binding LogoutCommand}"/>
                    <Button Content="退出"
                            Width="80" Height="26"
                            Click="BtnExit_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>