<UserControl x:Class="WPF_MES_MVVM.Views.ShareInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题（保留，用作页面内标题） -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="14,10">
            <TextBlock Text="共享信息中心"
                       FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="路径：" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding ShareRoot, UpdateSourceTrigger=PropertyChanged}"
                             Width="240" Height="28"
                             VerticalContentAlignment="Center"
                             Padding="8,0"/>
                    <TextBlock Text="\" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                             Width="150" Height="28"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Margin="0,0,14,0"/>

                    <TextBlock Text="{Binding ConnectionStatus}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,14,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="连接" Command="{Binding ConnectCommand}"
                            Style="{StaticResource PrimaryButton}" Width="70" Margin="0,0,8,0"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource SecondaryButton}" Width="70" Margin="0,0,8,0"/>
                    <Button Content="加载" Command="{Binding LoadDocumentCommand}"
                            Style="{StaticResource SecondaryButton}" Width="70" Margin="0,0,8,0"/>
                    <Button Content="保存" Command="{Binding SaveDocumentCommand}"
                            Style="{StaticResource PrimaryButton}" Width="70"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：树 | 编辑器 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：树 -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource InfoCardHeaderStyle}">
                        <TextBlock Text="信息树" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8">
                        <Button Content="+ 根节点" Command="{Binding AddRootNodeCommand}"
                                Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="+ 子节点" Command="{Binding AddChildNodeCommand}"
                                Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="删除" Command="{Binding DeleteNodeCommand}"
                                Style="{StaticResource SmallButtonStyle}"/>
                    </StackPanel>

                    <TreeView Grid.Row="2"
                              x:Name="tree"
                              ItemsSource="{Binding RootNodes}"
                              Background="Transparent"
                              BorderThickness="0"
                              Margin="6,0,6,6"
                              SelectedItemChanged="Tree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="  " />
                                    <TextBlock Text="{Binding Author}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- 右：编辑器（保持原样） -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource InfoCardHeaderStyle}">
                        <TextBlock Text="节点详情" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="标题" Style="{StaticResource Lbl}"/>
                            <TextBox Height="30" Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="作者" Style="{StaticResource Lbl}"/>
                            <TextBox Height="30" Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNode.Author, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="文字内容" Style="{StaticResource Lbl}"/>
                            <TextBox Height="140"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="8,4"
                                     Text="{Binding SelectedNode.Text, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="图片" Style="{StaticResource Lbl}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="选择图片"
                                        Command="{Binding PickImageCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="90" Margin="0,0,8,0"/>
                                <Button Content="清除"
                                        Command="{Binding ClearImageCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="70"/>
                            </StackPanel>

                            <Border Background="#FAFAFA"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MinHeight="180"
                                    Padding="8"
                                    Margin="0,0,0,16">
                                <Image Source="{Binding SelectedNode.ImageBase64, Converter={StaticResource Base64ToImage}}"
                                       Stretch="Uniform"
                                       MaxHeight="300"/>
                            </Border>

                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11">
                                <Run Text="最后更新："/>
                                <Run Text="{Binding SelectedNode.UpdateTime, StringFormat='yyyy-MM-dd HH:mm:ss', Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>