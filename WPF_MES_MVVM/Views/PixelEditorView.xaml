<UserControl x:Class="WPF_MES_MVVM.Views.PixelEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <!-- 稍微加宽左侧以容纳颜色列表 -->
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =========== 左侧：控制面板 =========== -->
        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="10,10,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource InfoCardHeaderStyle}">
                    <TextBlock Text="像素控制台" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding ImageName, StringFormat='当前图片: {0}'}" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource PrimaryBrush}" 
                           Margin="0,0,0,10" 
                           TextTrimming="CharacterEllipsis"/>
                        <!-- 文件操作 -->
                        <Button Content="加载图片" Command="{Binding LoadImageCommand}" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,0,10"/>
                        <Button Content="保存为新 PNG" Command="{Binding SaveImageCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,0,10"/>

                        <!-- ★ 点阵导出与导入 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="导出点阵 TXT" Command="{Binding ExportMatrixTxtCommand}" Style="{StaticResource SecondaryButton}" Height="32"/>
                            <Button Grid.Column="2" Content="导入点阵 TXT" Command="{Binding ImportMatrixTxtCommand}" Style="{StaticResource SecondaryButton}" Height="32"/>
                        </Grid>

                        <Button Content="导出颜色统计 (TXT)" Command="{Binding ExportColorTxtCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,0,15"/>

                        <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,15"/>

                        <!-- ★ 一键替换颜色区域 -->
                        <TextBlock Text="一键批量替换颜色" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ReplaceColorsText, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6,4" Margin="0,0,0,8"
                                ToolTip="输入格式如：{[#FFFFFF,#000000],[#FF0000,#00FF00]}"/>
                        <Button Content="执行颜色替换" Command="{Binding ExecuteColorReplaceCommand}" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,0,15"/>

                        <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,15"/>

                        <!-- 颜色预览与开关 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding CurrentColorBrush.Color}" />
                                </Border.Background>
                            </Border>
                            <CheckBox Grid.Column="1" Content="修改画布上所有相同颜色" IsChecked="{Binding SyncSameColor}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- RGBA 滑块 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="红 (R)" Style="{StaticResource FormLabel}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Red}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#D32F2F"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="绿 (G)" Style="{StaticResource FormLabel}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Green}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#388E3C"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="蓝 (B)" Style="{StaticResource FormLabel}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Blue}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1976D2"/>
                        </Grid>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="透明 (A)" Style="{StaticResource FormLabel}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Alpha}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Alpha}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,15"/>

                        <!-- 颜色分类 -->
                        <TextBlock Text="画布颜色分类" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- ★ 列表：显示色块 + HEX 代码 -->
                        <ItemsControl ItemsSource="{Binding ColorGroups}" Margin="0,0,0,15">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding Color}" 
                                            ToolTip="{Binding Count, StringFormat='包含 {0} 个像素'}"
                                            Margin="0,0,6,6">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="14" Height="14" CornerRadius="2" BorderBrush="#CCC" BorderThickness="1" Background="{Binding Brush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding HexCode}" Margin="6,0,2,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HEX 值" Style="{StaticResource FormLabel}"/>
                            <!-- 直接双向绑定 HexInput 即可，不需要 Converter -->
                            <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" 
                                 Text="{Binding HexInput, UpdateSourceTrigger=LostFocus}" 
                                 ToolTip="输入 #RRGGBB 或 #AARRGGBB 后点击空白处生效" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- =========== 右侧：画布 =========== -->
        <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SuccessCardHeaderStyle}">
                    <TextBlock Text="编辑区" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}"/>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F0F4F8">
                    <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Pixels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                 Columns="{Binding DataContext.GridCols, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 改用 ToggleButton，用于区分选中状态 -->
                                    <Button Command="{Binding DataContext.SelectPixelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{Binding Brush}" Width="12" Height="12" BorderBrush="#15000000" BorderThickness="0.5"/>
                                                <ControlTemplate.Triggers>
                                                    <!-- 高亮当前正在编辑的格子 -->
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <!-- 这里可以通过样式简单高亮，为了不破坏颜色，仅加边框 -->
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>