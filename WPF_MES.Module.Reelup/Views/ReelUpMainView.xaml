<UserControl x:Class="WPF_MES.Module.ReelUp.Views.ReelUpMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 复用 AOI 模块的 SharedStyles -->
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶部标题 -->
            <RowDefinition Height="*"/>
            <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部状态提示 -->
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="14,10">
            <Grid>
                <TextBlock Text="ReelUp 上料与投入产出系统" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding UserStatusText}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 主体 TabControl -->
        <TabControl Grid.Row="1" Margin="10" Background="Transparent" BorderThickness="0" Padding="0"
                    ItemContainerStyle="{StaticResource FlatTabItem}">

            <!-- Tab 1: 上料监控 -->
            <TabItem Header="上料监控">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <!-- 稍微加宽左侧，放得下按钮 -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧树形导航 -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 工具栏：分两行显示 -->
                            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10, 10, 10, 5">

                                <!-- 第一行：楼层选择 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="楼层:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableFloors}" 
                                      SelectedItem="{Binding SelectedFloor}" 
                                      Width="80" Height="28"/>
                                </StackPanel>

                                <!-- 第二行：操作按钮 -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="全部连接" Command="{Binding ConnectAllCommand}" Style="{StaticResource PrimaryButton}" Height="28" Padding="10,0" Margin="0,0,5,0"/>
                                    <Button Content="全部关闭" Command="{Binding DisconnectAllCommand}" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Margin="0,0,10,0"/>

                                    <!-- 只有开发者能看到新增终端 -->
                                    <Button Content="新增终端" Command="{Binding AddTerminalCommand}" 
                                        Style="{StaticResource PrimaryButton}" Height="28" Padding="10,0"
                                        Visibility="{Binding IsDeveloper, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- TreeView -->
                            <TreeView Grid.Row="1" ItemsSource="{Binding NavigationTree}" BorderThickness="0" Background="Transparent" Margin="5">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>

                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <!-- 状态指示灯 -->
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <!-- 如果绑定的业务数据 (Tag) 是空，说明是线别或楼层节点，直接隐藏指示灯 -->
                                                            <DataTrigger Binding="{Binding Tag}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- 节点名称 + 双击事件 -->
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                          Command="{Binding DataContext.ToggleNodeConnectionCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" 
                                                          CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- 右侧数据展示 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <!-- 实时通讯记录 -->
                        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <DataGrid ItemsSource="{Binding ReelUpLogs}" Style="{StaticResource DataGridStyle}" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding StrTime}" Width="150"/>
                                    <DataGridTextColumn Header="IP" Binding="{Binding StrIp}" Width="120"/>
                                    <DataGridTextColumn Header="线别" Binding="{Binding StrLine}" Width="100"/>
                                    <DataGridTextColumn Header="扫码数据" Binding="{Binding StrData}" Width="*"/>
                                    <DataGridTextColumn Header="系统反馈" Binding="{Binding Feedback}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 下方配置表 -->
                        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding ReelUpConfigs}" Style="{StaticResource DataGridStyle}" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="业务组" Binding="{Binding Group}" Width="100"/>
                                    <DataGridTextColumn Header="线别" Binding="{Binding Line}" Width="150"/>
                                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="150"/>
                                    <DataGridTextColumn Header="枪型" Binding="{Binding GunType}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: 投入产出 -->
            <TabItem Header="投入产出监控">
                <Grid Margin="0,10,0,0">
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding IoLogs}" Style="{StaticResource DataGridStyle}" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding StrTime}" Width="150"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding StrIp}" Width="120"/>
                                <DataGridTextColumn Header="线别" Binding="{Binding StrLine}" Width="100"/>
                                <DataGridTextColumn Header="SN" Binding="{Binding StrData}" Width="*"/>
                                <DataGridTextColumn Header="反馈" Binding="{Binding Feedback}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: 设置 (仅开发者可见) -->
            <TabItem Header="设置" Visibility="{Binding IsDeveloper, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="10" Padding="30">
                    <Grid Width="600" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- 补上了这一行 -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="开发者全局配置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="数据库连接串:" VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CfgConnString, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="默认选中楼栋:" VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CfgDefaultBuilding, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" VerticalContentAlignment="Center" Margin="0,0,0,15" Width="100" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="扫码超时(毫秒):" VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CfgGunTimeout, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0" VerticalContentAlignment="Center" Margin="0,0,0,15" Width="100" HorizontalAlignment="Left"/>

                        <Button Grid.Row="4" Grid.Column="1" Content="保存配置" Command="{Binding SaveConfigCommand}" 
                                Style="{StaticResource PrimaryButton}" Width="120" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- 底部状态栏（精简：去掉了色块，只保留文字） -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,1,0" Padding="10,6">
            <Grid>
                <TextBlock Text="{Binding DeviceStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>