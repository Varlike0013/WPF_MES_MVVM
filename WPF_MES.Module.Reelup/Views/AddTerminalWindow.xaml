<Window x:Class="WPF_MES.Module.ReelUp.Views.AddTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增终端配置" Width="400" Height="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="添加新终端" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="业务组 (Group):" Margin="0,5"/>
            <ComboBox x:Name="CboGroup" Margin="0,0,0,10">
                <ComboBoxItem Content="ASSY"/>
                <ComboBoxItem Content="DIP"/>
                <ComboBoxItem Content="INPUT"/>
                <ComboBoxItem Content="OUTPUT"/>
            </ComboBox>

            <TextBlock Text="线别 (Line):" Margin="0,5"/>
            <TextBox x:Name="TxtLine" Height="28" Padding="5,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="终端 IP:" Margin="0,5"/>
            <TextBox x:Name="TxtIp" Height="28" Padding="5,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="终端 ID:" Margin="0,5"/>
            <TextBox x:Name="TxtId" Height="28" Padding="5,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="枪型 (GunType):" Margin="0,5"/>
            <ComboBox x:Name="CboGunType" Margin="0,0,0,10">
                <ComboBoxItem Content="M101"/>
                <ComboBoxItem Content="M131"/>
                <ComboBoxItem Content="PM9300"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Margin="0,0,10,0" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
            <Button Content="保存" Width="80" Click="OnSaveClick" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>