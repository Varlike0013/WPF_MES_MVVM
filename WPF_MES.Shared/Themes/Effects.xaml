<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 卡片柔和阴影：x:Shared=False 保证每个使用者拿独立实例，避免冻结冲突 -->
    <DropShadowEffect x:Key="SoftShadow" x:Shared="False"
                      Color="#000000"
                      BlurRadius="8"
                      ShadowDepth="1"
                      Opacity="0.08"/>

    <!-- 更轻的阴影：表头 / 小卡片 -->
    <DropShadowEffect x:Key="LightShadow" x:Shared="False"
                      Color="#000000"
                      BlurRadius="4"
                      ShadowDepth="1"
                      Opacity="0.05"/>

</ResourceDictionary>