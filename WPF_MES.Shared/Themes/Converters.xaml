<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:WPF_MES.Shared.Converters">

    <!-- 布尔 / 取反 -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <conv:InverseBoolConverter      x:Key="InverseBool"/>

    <!-- 图片 -->
    <conv:Base64ToImageConverter   x:Key="Base64ToImage"/>
    
</ResourceDictionary>