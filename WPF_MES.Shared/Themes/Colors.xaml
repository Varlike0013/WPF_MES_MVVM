<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主色 -->
    <Color x:Key="PrimaryColor">#007ACC</Color>
    <Color x:Key="PrimaryHoverColor">#005A9E</Color>
    <SolidColorBrush x:Key="PrimaryBrush"      Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>

    <!-- 危险 -->
    <SolidColorBrush x:Key="DangerBrush"      Color="#D9534F"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C9302C"/>

    <!-- 语义背景 -->
    <SolidColorBrush x:Key="InfoHeaderBrush"    Color="#E8EEF7"/>
    <SolidColorBrush x:Key="SuccessHeaderBrush" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="SuccessTextBrush"   Color="#2E7D32"/>

    <!-- 中性 -->
    <SolidColorBrush x:Key="PageBackgroundBrush"  Color="#F5F7FA"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush"      Color="#DDDDDD"/>
    <SolidColorBrush x:Key="GridLineBrush"        Color="#EEEEEE"/>
    <SolidColorBrush x:Key="SecondaryBgBrush"     Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush"  Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="DisabledBgBrush"      Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DisabledFgBrush"      Color="#999999"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#333333"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#666666"/>

    <!-- ===== 表格交替行色 ===== -->
    <!-- 奇数行 -->
    <SolidColorBrush x:Key="RowOddBrush"      Color="#FFFFFF"/>
    <!-- 偶数行 -->
    <SolidColorBrush x:Key="RowEvenBrush"     Color="#DCE6F1"/>
    <!-- 鼠标悬停 -->
    <SolidColorBrush x:Key="RowHoverBrush"    Color="#C7DCEF"/>
    <!-- 选中 -->
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#A8C8E4"/>

    <!-- 语义色（值标签柔和红） -->
    <SolidColorBrush x:Key="ValueRedBrush"    Color="#D32F2F"/>
    <SolidColorBrush x:Key="RowNgBrush"       Color="#C83232"/>

</ResourceDictionary>