<UserControl x:Class="WPF_MES.Module.AOI.Views.AoiMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="13">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPF_MES.Shared;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Lbl" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="14,10">
            <TextBlock Text="AOI 自动光学检测" FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <TabControl Grid.Row="1" Margin="10"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            SelectedIndex="0"
            ItemContainerStyle="{StaticResource FlatTabItem}">

            <!-- ========== Tab1: AOI 主界面 ========== -->
            <TabItem Header="AOI">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 按钮条 -->
                    <Border Grid.Row="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="开始监控" Command="{Binding StartWatchCommand}"
                                        Style="{StaticResource PrimaryButton}" Width="90" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsWatching, Converter={StaticResource InverseBool}}"/>
                                <Button Content="停止监控" Command="{Binding StopWatchCommand}"
                                        Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsWatching}"/>
                                <Button Content="批量上传" Command="{Binding ExecuteCommand}"
                                        Style="{StaticResource PrimaryButton}" Width="90"/>
                            </StackPanel>

                            <TextBlock Text="{Binding StatusText}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- 结果表格 -->
                    <Border Grid.Row="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding Results}"
                                  Style="{StaticResource DataGridStyle}"
                                  BorderThickness="0"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="线别"     Binding="{Binding LineName}"      Width="100"/>
                                <DataGridTextColumn Header="序号"     Binding="{Binding SerialNumber}"  Width="180"/>
                                <DataGridTextColumn Header="时间"     Binding="{Binding OutputTime}"    Width="160"/>
                                <DataGridTextColumn Header="结果"     Binding="{Binding Result}"        Width="*"/>
                                <DataGridTextColumn Header="异常数量" Binding="{Binding AbnormalCount}" Width="90"/>
                            </DataGrid.Columns>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding Result}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="OK">
                                            <Setter Property="Background" Value="#E7F5EC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="REPAIR">
                                            <Setter Property="Background" Value="#FFF6DC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="ERROR">
                                            <Setter Property="Background" Value="#FDE7E7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== Tab2: 设置 ========== -->
            <TabItem Header="设置">
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="30" Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 源目录 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="源文件夹：" Style="{StaticResource Lbl}"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding DirPath, UpdateSourceTrigger=PropertyChanged}"
                                   Height="28" Padding="8,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Row="0" Grid.Column="4" Content="..."
                                Command="{Binding SelectDirCommand}"
                                Style="{StaticResource SecondaryButton}"/>

                        <!-- 备份目录 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="备份文件夹：" Style="{StaticResource Lbl}"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding BackupDir, UpdateSourceTrigger=PropertyChanged}"
                                   Height="28" Padding="8,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Row="1" Grid.Column="4" Content="..."
                                Command="{Binding SelectBackupDirCommand}"
                                Style="{StaticResource SecondaryButton}"/>

                        <!-- 线别 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="线别：" Style="{StaticResource Lbl}"/>
                        <ComboBox  Grid.Row="2" Grid.Column="1"
                                   ItemsSource="{Binding LineOptions}"
                                   SelectedItem="{Binding Line}"
                                   Height="28"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="线别ID："
                                   Style="{StaticResource Lbl}" Margin="20,0,8,0"/>
                        <TextBox   Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                                   Text="{Binding LineIdText}"
                                   IsReadOnly="True" Height="28"
                                   Padding="8,0" VerticalContentAlignment="Center"/>

                        <!-- 终端 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="终端：" Style="{StaticResource Lbl}"/>
                        <ComboBox  Grid.Row="3" Grid.Column="1"
                                   ItemsSource="{Binding TerminalOptions}"
                                   SelectedItem="{Binding Terminal}"
                                   Height="28"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="终端ID："
                                   Style="{StaticResource Lbl}" Margin="20,0,8,0"/>
                        <TextBox   Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                                   Text="{Binding TerminalIdText}"
                                   Height="28" Padding="8,0" VerticalContentAlignment="Center"/>

                        <!-- API Check -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="API CHECK：" Style="{StaticResource Lbl}"/>
                        <ComboBox  Grid.Row="4" Grid.Column="1"
                                   ItemsSource="{Binding ApiCheckOptions}"
                                   SelectedItem="{Binding ApiCheck}"
                                   Height="28"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="API TRAVEL："
                                   Style="{StaticResource Lbl}" Margin="20,0,8,0"/>
                        <ComboBox  Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2"
                                   ItemsSource="{Binding ApiTravelOptions}"
                                   SelectedItem="{Binding ApiTravel}"
                                   Height="28"/>

                        <!-- Type -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="类型：" Style="{StaticResource Lbl}"/>
                        <ComboBox  Grid.Row="5" Grid.Column="1"
                                   ItemsSource="{Binding TypeOptions}"
                                   SelectedItem="{Binding Type}"
                                   Height="28"/>

                        <!-- 保存 -->
                        <Button Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="2"
                                Content="保存配置"
                                Command="{Binding SaveConfigCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="120"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,16,0,0"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>